{
  "name": "breaking-apps-hackathon",
  "version": "1.0.0",
  "description": "AI regression testing of a vibe-coded DevLog app using Passmark",
  "main": "index.js",
  "scripts": {
    "serve": "http-server . -p 3000 --cors -c-1 --silent",
    "test": "playwright test --project chromium",
    "test:headed": "playwright test --project chromium --headed",
    "test:devlog": "playwright test tests/devlog.spec.ts --project chromium",
    "test:devlog:headed": "playwright test tests/devlog.spec.ts --project chromium --headed",
    "report": "playwright show-report"
  },
