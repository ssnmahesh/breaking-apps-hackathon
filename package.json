  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "http-server": "^14.1.1"
  },
  "dependencies": {
    "@openrouter/ai-sdk-provider": "^2.9.0",
    "ai": "^6.0.177",
    "dotenv": "^17.4.2",
    "passmark": "^1.0.13",
    "tsx": "^4.21.0"
  }
}
